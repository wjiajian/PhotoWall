# PhotoWall 环境变量配置

# 服务端口，默认 3000
# PORT=3000

# 运行环境：development 或 production
# NODE_ENV=development

# 生产环境允许访问后端的前端域名，多个域名用英文逗号分隔
# CORS_ORIGIN=https://photos.example.com

# 管理员登录配置
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# 生产环境可使用 ADMIN_PASSWORD，安全性更高的做法是改用 ADMIN_PASSWORD_HASH
# 生成方式示例：node -e "console.log(require('bcryptjs').hashSync('your_password', 10))"
# ADMIN_PASSWORD_HASH=$2a$10$...
JWT_SECRET=your_random_secret_key_change_in_production

# 照片上传限制
# 单个文件最大体积，单位 MB，默认 25
# PHOTO_UPLOAD_MAX_MB=25
# 后端每批最多接收多少个文件，默认 1
# PHOTO_UPLOAD_MAX_FILES_PER_BATCH=1
# 后端每批上传总大小限制，单位 MB，默认 60
# PHOTO_UPLOAD_MAX_BATCH_MB=60
# 上传临时目录，留空时使用系统临时目录
# PHOTO_UPLOAD_TMP_DIR=
# sharp 图片处理并发，低配服务器建议保持 1
# PHOTO_PROCESS_SHARP_CONCURRENCY=1
## OSS 单次操作的超时时间，单位毫秒，默认 60000（60 秒）
# PHOTO_OSS_OPERATION_TIMEOUT_MS=60000
## 单张照片处理的总超时时间，单位毫秒，默认 300000（5 分钟）
# PHOTO_UPLOAD_FILE_TIMEOUT_MS=300000
## worker 内 CPU 处理（解码/缩放/编码）的超时，单位毫秒，默认 120000（2 分钟）
## 超时会 terminate worker 真正中断卡死任务；取值会被限制为不超过上面的总超时
# PHOTO_PROCESS_TIMEOUT_MS=120000

# 照片处理 worker（worker_threads 子线程，避免重活阻塞主线程导致服务卡死）
## worker 每处理多少张后回收重建一次，释放原生内存，默认 20
# PHOTO_WORKER_RECYCLE_EVERY=20
## worker 子线程的 V8 老生代堆上限，单位 MB，默认 256
# PHOTO_WORKER_MAX_OLD_SPACE_MB=256
## 设为 1 可强制关闭 worker，改为主线程内联处理（一般仅用于排查问题）
# PHOTO_WORKER_DISABLED=0

# 缩略图 mozjpeg 编码：画质更优但 CPU 开销约为基线 3~5 倍
## 单核/低配服务器若处理期间 CPU 打满，可将 full 变体设为 false 大幅降负载
# PHOTO_THUMBNAIL_FULL_MOZJPEG=true
# PHOTO_THUMBNAIL_MEDIUM_MOZJPEG=true
## full 变体最长边像素上限，默认 0（不缩放，保留原始分辨率）；设为如 4096 可显著降负载
# PHOTO_THUMBNAIL_FULL_MAX_PX=0
# 管理端自动分批上传时每批最多文件数，应与后端限制保持一致
# VITE_PHOTO_UPLOAD_MAX_FILES_PER_BATCH=1
# 管理端自动分批上传时每批总大小，单位 MB
# VITE_PHOTO_UPLOAD_BATCH_MB=30

# 照片墙 OSS 公开访问地址，不要带末尾斜杠
# 服务端会把 metadata 中 /photowall/ 开头的路径改写到这个域名
# OSS_PHOTOWALL_BASE_URL=https://myblog-photowall.oss-cn-hangzhou.aliyuncs.com
# 前端构建时使用的 OSS 公开访问地址，通常和 OSS_PHOTOWALL_BASE_URL 相同
# VITE_OSS_PHOTOWALL_BASE_URL=https://myblog-photowall.oss-cn-hangzhou.aliyuncs.com

# OSS 写入配置，用于后台上传和删除照片
# OSS_REGION=oss-cn-hangzhou
# OSS_BUCKET=myblog-photowall
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# 可选：自定义 OSS endpoint
# OSS_ENDPOINT=
