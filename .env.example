# PhotoWall 环境变量配置

# 服务端口，默认 3000
# PORT=3000

# 运行环境：development 或 production
# NODE_ENV=development

# 生产环境允许访问后端的前端域名，多个域名用英文逗号分隔
# CORS_ORIGIN=https://photos.example.com

# 管理员登录配置
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# 生产环境建议使用 ADMIN_PASSWORD_HASH，不要使用明文 ADMIN_PASSWORD
# 生成方式示例：node -e "console.log(require('bcryptjs').hashSync('your_password', 10))"
# ADMIN_PASSWORD_HASH=$2a$10$...
JWT_SECRET=your_random_secret_key_change_in_production

# 照片上传限制
# 单个文件最大体积，单位 MB，默认 50
# PHOTO_UPLOAD_MAX_MB=50
# 后端每批最多接收多少个文件，默认 3
# PHOTO_UPLOAD_MAX_FILES_PER_BATCH=3
# 后端每批上传总大小限制，单位 MB，默认 60
# PHOTO_UPLOAD_MAX_BATCH_MB=60
# 上传临时目录，留空时使用系统临时目录
# PHOTO_UPLOAD_TMP_DIR=
# sharp 图片处理并发，低配服务器建议保持 1
# PHOTO_PROCESS_SHARP_CONCURRENCY=1
# 管理端自动分批上传时每批最多文件数，应与后端限制保持一致
# VITE_PHOTO_UPLOAD_MAX_FILES_PER_BATCH=3
# 管理端自动分批上传时每批总大小，单位 MB
# VITE_PHOTO_UPLOAD_BATCH_MB=30

# 照片墙 OSS 公开访问地址，不要带末尾斜杠
# 服务端会把 metadata 中 /photowall/ 开头的路径改写到这个域名
# OSS_PHOTOWALL_BASE_URL=https://myblog-photowall.oss-cn-hangzhou.aliyuncs.com
# 前端构建时使用的 OSS 公开访问地址，通常和 OSS_PHOTOWALL_BASE_URL 相同
# VITE_OSS_PHOTOWALL_BASE_URL=https://myblog-photowall.oss-cn-hangzhou.aliyuncs.com

# OSS 写入配置，用于后台上传和删除照片
# OSS_REGION=oss-cn-hangzhou
# OSS_BUCKET=myblog-photowall
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# 可选：自定义 OSS endpoint
# OSS_ENDPOINT=
