# PhotoWall 环境变量配置

# 服务端口，默认 3000
# PORT=3000

# 运行环境：development 或 production
# NODE_ENV=development

# 生产环境允许访问后端的前端域名，多个域名用英文逗号分隔
# CORS_ORIGIN=https://photos.example.com

# 管理员登录配置
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# 生产环境可使用 ADMIN_PASSWORD，安全性更高的做法是改用 ADMIN_PASSWORD_HASH
# 生成方式示例：node -e "console.log(require('bcryptjs').hashSync('your_password', 10))"
# ADMIN_PASSWORD_HASH=$2a$10$...
JWT_SECRET=your_random_secret_key_change_in_production

# 照片上传限制：新上传仅支持 JPG/JPEG，单文件硬上限 20MB
# 单个文件最大体积，单位 MB；可调低但不能超过 20
# PHOTO_UPLOAD_MAX_MB=20
# 后端每批固定接收 1 个文件
# PHOTO_UPLOAD_MAX_FILES_PER_BATCH=1
# 后端每批上传总大小限制，单位 MB，应与单文件限制一致
# PHOTO_UPLOAD_MAX_BATCH_MB=20
# 上传临时目录，留空时使用系统临时目录
# PHOTO_UPLOAD_TMP_DIR=
## OSS 单次操作的超时时间，单位毫秒，默认 60000（60 秒）
# PHOTO_OSS_OPERATION_TIMEOUT_MS=60000
# 管理端自动分批上传时每批固定 1 个文件
# VITE_PHOTO_UPLOAD_MAX_FILES_PER_BATCH=1
# 管理端单文件/单批上限，单位 MB，应与后端保持一致
# VITE_PHOTO_UPLOAD_BATCH_MB=20

# 照片墙 OSS 公开访问地址，不要带末尾斜杠
# 服务端会把 metadata 中 /photowall/ 开头的路径改写到这个域名
# OSS_PHOTOWALL_BASE_URL=https://myblog-photowall.oss-cn-hangzhou.aliyuncs.com
# 前端构建时使用的 OSS 公开访问地址，通常和 OSS_PHOTOWALL_BASE_URL 相同
# VITE_OSS_PHOTOWALL_BASE_URL=https://myblog-photowall.oss-cn-hangzhou.aliyuncs.com

# OSS 写入配置，用于后台上传和删除照片
# OSS_REGION=oss-cn-hangzhou
# OSS_BUCKET=myblog-photowall
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# 可选：自定义 OSS endpoint
# OSS_ENDPOINT=

# 可选：真实 OSS 与 100 张压力验收
# PHOTO_TEST_OSS_PREFIX=photowall-test/persistent
# PHOTO_STRESS_CONFIRM=UPLOAD_100_TEST_PHOTOS
# PHOTO_STRESS_BASE_URL=https://photos.example.com
# PHOTO_STRESS_INPUT_DIR=/path/to/100-jpegs
# PHOTO_STRESS_CONTAINER=photowall
# PHOTO_STRESS_SSH_HOST=server.example.com
# PHOTO_STRESS_SSH_PORT=22
# PHOTO_STRESS_HEALTH_URLS=https://photos.example.com/,https://photos.example.com/api/photos/metadata
# PHOTO_STRESS_MAX_GROWTH_MB=96
