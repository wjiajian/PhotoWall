{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist-server",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "verbatimModuleSyntax": false
  },
  "include": [
    "server.ts",
    "src/config/**/*.ts",
    "src/middleware/**/*.ts",
    "src/routes/**/*.ts",
    "src/services/**/*.ts",
    "src/utils/photoUrl.ts",
    "src/utils/siteSettings.ts"
  ]
}
